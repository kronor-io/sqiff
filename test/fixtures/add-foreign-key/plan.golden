-- table constraint public.child.child_parent_id_fkey
-- hazard: also locks public.parent while it runs
alter table public.child add constraint child_parent_id_fkey foreign key (parent_id) references public.parent(id) on delete cascade not valid;

-- table constraint public.child.child_parent_id_fkey
-- own transaction
alter table public.child validate constraint child_parent_id_fkey;

