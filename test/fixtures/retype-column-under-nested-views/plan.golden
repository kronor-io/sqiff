-- table column public.t.amount
-- hazard: may rewrite the table
-- hazard: holds an ACCESS EXCLUSIVE lock, which blocks reads and writes, while it runs
-- hazard: fails when an existing value does not convert to the new type
-- hazard: recreating a view fails when its query relies on the old type; then edit the view
drop view public.w;
drop view public.v;
alter table public.t alter column amount type bigint using amount::bigint;
create view public.v as
select id,
    amount
   from public.t;
create view public.w as
select id,
    (amount * 2) as doubled
   from public.v;
do $$ declare g text; begin for g in select distinct case when x.grantee = 0 then 'public' else quote_ident(pg_get_userbyid(x.grantee)) end from pg_class c cross join aclexplode(c.relacl) x where c.oid = 'public.w'::regclass and x.grantee <> c.relowner loop execute format('revoke all on table %s from %s', 'public.w', g); end loop; end $$;
grant select on table public.w to reader;
grant delete on table public.w to sqiff;
grant insert on table public.w to sqiff;
grant maintain on table public.w to sqiff;
grant references on table public.w to sqiff;
grant select on table public.w to sqiff;
grant trigger on table public.w to sqiff;
grant truncate on table public.w to sqiff;
grant update on table public.w to sqiff;

