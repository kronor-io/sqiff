-- index app.events_at
CREATE INDEX events_at ON ONLY app.events USING btree (at);

-- index app.events_at
-- outside a transaction
-- hazard: builds an index
select
    format('CREATE INDEX CONCURRENTLY IF NOT EXISTS %I ON %I.%I USING btree (at)', left(c.relname || '_' || 'events_at', 63), n.nspname, c.relname),
    format('alter index %s attach partition %I.%I', 'app.events_at', n.nspname, left(c.relname || '_' || 'events_at', 63))
from pg_inherits h
join pg_class c on c.oid = h.inhrelid
join pg_namespace n on n.oid = c.relnamespace
where h.inhparent = 'app.events'::regclass
    and not exists (
        select from pg_inherits a
        join pg_index x on x.indexrelid = a.inhrelid
        where a.inhparent = 'app.events_at'::regclass and x.indrelid = c.oid
    )
order by c.relname
\gexec

-- index app.events_id_at
CREATE UNIQUE INDEX events_id_at ON ONLY app.events USING btree (id, at) WHERE (note ~~ 'it''s %'::text);

-- index app.events_id_at
-- outside a transaction
-- hazard: builds an index
select
    format('CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS %I ON %I.%I USING btree (id, at) WHERE (note ~~ ''it''''s %%''::text)', left(c.relname || '_' || 'events_id_at', 63), n.nspname, c.relname),
    format('alter index %s attach partition %I.%I', 'app.events_id_at', n.nspname, left(c.relname || '_' || 'events_id_at', 63))
from pg_inherits h
join pg_class c on c.oid = h.inhrelid
join pg_namespace n on n.oid = c.relnamespace
where h.inhparent = 'app.events'::regclass
    and not exists (
        select from pg_inherits a
        join pg_index x on x.indexrelid = a.inhrelid
        where a.inhparent = 'app.events_id_at'::regclass and x.indrelid = c.oid
    )
order by c.relname
\gexec

