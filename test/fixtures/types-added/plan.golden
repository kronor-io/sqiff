-- type app.mood
create type app.mood as enum ('it''s fine', 'ok');

-- type app.pair
create type app.pair as (x integer, "Y" text);

-- type app.positive
create domain app.positive as integer not null default 1;

-- type app.span
create type app.span as range (subtype = double precision);

-- function app.span(double precision, double precision)
CREATE OR REPLACE FUNCTION app.span(double precision, double precision)
 RETURNS app.span
 LANGUAGE internal
 IMMUTABLE PARALLEL SAFE
AS $function$range_constructor2$function$;

-- function app.span(double precision, double precision, pg_catalog.text)
CREATE OR REPLACE FUNCTION app.span(double precision, double precision, text)
 RETURNS app.span
 LANGUAGE internal
 IMMUTABLE PARALLEL SAFE
AS $function$range_constructor3$function$;

-- function app.span_multirange
CREATE OR REPLACE FUNCTION app.span_multirange()
 RETURNS app.span_multirange
 LANGUAGE internal
 IMMUTABLE PARALLEL SAFE STRICT
AS $function$multirange_constructor0$function$;

-- function app.span_multirange(app.span)
CREATE OR REPLACE FUNCTION app.span_multirange(app.span)
 RETURNS app.span_multirange
 LANGUAGE internal
 IMMUTABLE PARALLEL SAFE STRICT
AS $function$multirange_constructor1$function$;

-- function app.span_multirange(app.span[])
CREATE OR REPLACE FUNCTION app.span_multirange(VARIADIC app.span[])
 RETURNS app.span_multirange
 LANGUAGE internal
 IMMUTABLE PARALLEL SAFE STRICT
AS $function$multirange_constructor2$function$;

