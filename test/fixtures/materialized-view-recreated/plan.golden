-- materialized view public.mv
-- hazard: fails when other objects depend on it
drop materialized view public.mv;

-- materialized view public.mv
-- hazard: holds an ACCESS EXCLUSIVE lock, which blocks reads and writes, while it runs
create materialized view public.mv as
select id,
    a,
    (a * 2) as b
   from public.t;

-- materialized view public.mv
-- hazard: builds an index
create index mv_a on public.mv using btree (a);

