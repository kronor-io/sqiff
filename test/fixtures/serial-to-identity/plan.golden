-- table column public.t.id
do $$
declare seq text := pg_get_serial_sequence('public.t', 'id'); last bigint; called boolean; acl aclitem[];
begin
    execute format('select last_value, is_called from %s', seq) into last, called;
    select relacl into acl from pg_class where oid = seq::regclass;
    alter table public.t alter column id drop default;
    execute format('drop sequence %s', seq);
    alter table public.t alter column id add generated by default as identity;
    perform setval(pg_get_serial_sequence('public.t', 'id'), last, called);
    execute coalesce((select string_agg(format('grant %s on sequence %s to %s', x.privilege_type, pg_get_serial_sequence('public.t', 'id'), case when x.grantee = 0 then 'public' else quote_ident(pg_get_userbyid(x.grantee)) end), '; ') from aclexplode(acl) x where x.grantee <> x.grantor), 'select');
end $$;

