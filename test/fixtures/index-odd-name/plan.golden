-- index public.odd$$name%s
-- outside a transaction
-- hazard: builds an index
do $sqiff$
begin
    if exists (
        select from pg_index
        where indexrelid = to_regclass('public."odd$$name%s"') and not indisvalid
    ) then
        raise exception using message = 'index public."odd$$name%s" is invalid from an earlier failed build; drop it first';
    end if;
end
$sqiff$;

CREATE INDEX CONCURRENTLY "odd$$name%s" ON public.t USING btree (note) WHERE ((note <> ' INDEX '::text) AND (note <> 'concurrently '::text));

-- table public.t
comment on table public.t is E'a\\b';

