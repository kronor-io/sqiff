#!/usr/bin/env bash
# sqiff linked statically against musl, for the tarballs a version tag attaches
# to its GitHub release (.github/workflows/check.yml): one file that runs on any
# Linux distribution, for the architecture this runs on.
#
#   scripts/build-static     writes dist-static/sqiff-<arch>-linux.tar.xz
#
# It builds in Alpine, with the GHC of the ghc-musl image, since nixpkgs and
# haskell.nix would compile a musl GHC first. Outside that image it runs itself
# in it with docker. cabal's store and build directory stay in dist-static/, so
# a later run, or CI's cache of that folder, reuses them.
#
# The tarball holds bin/sqiff and its completion scripts under share/, so
# unpacking it into ~/.local or /usr/local installs both.
set -euo pipefail

cd "$(dirname "$0")/.."

# ghc-musl 9.12.4, the GHC the flake builds sqiff with.
image=docker.io/benz0li/ghc-musl:9.12.4@sha256:e5b180fb35e3520296e86efc3aafc2859821afb1be02ef55a7add7fb893606e5

if [ ! -e /etc/alpine-release ]; then
    exec docker run --rm -v "$PWD:/src" -w /src "$image" scripts/build-static
fi

out=dist-static
export CABAL_DIR="$PWD/$out/cabal"

# The image runs as root; leave the files to whoever owns the checkout, also
# when the build fails.
mkdir -p "$out"
trap 'chown -R "$(stat -c %u:%g .)" "$out"' EXIT

# libpq.a and what it links: OpenSSL, as libpq.pc's static libraries name.
apk add --no-cache libpq-dev openssl-libs-static binutils tar xz

# postgresql-libpq records the libraries pkg-config gives it, and the final link
# names them right after -lpq. Plain pkg-config gives -lpq alone; libpq.a also
# needs libpq.pc's Libs.private. Those name libpgcommon and libpgport, but libpq
# is built against their _shlib variants, which alone define what it uses.
cat > /usr/local/bin/pkg-config-static <<'WRAPPER'
#!/bin/bash
set -o pipefail
pkg-config --static "$@" | sed -e 's/-lpgcommon\b/-lpgcommon_shlib/' -e 's/-lpgport\b/-lpgport_shlib/'
WRAPPER
chmod +x /usr/local/bin/pkg-config-static

cabal update --builddir "$out/build"
cabal build exe:sqiff \
    --builddir "$out/build" \
    --enable-optimization \
    --enable-executable-static \
    --with-pkg-config=pkg-config-static

stage="$out/stage"
rm -rf "$stage"
mkdir -p "$stage/bin" \
    "$stage/share/bash-completion/completions" \
    "$stage/share/zsh/site-functions" \
    "$stage/share/fish/vendor_completions.d"
cp "$(cabal list-bin exe:sqiff --builddir "$out/build" --enable-optimization)" "$stage/bin/sqiff"
strip "$stage/bin/sqiff"

# A static binary has no interpreter or shared libraries to ask for; anything
# else would only run where they are installed.
if readelf -l "$stage/bin/sqiff" | grep -q INTERP; then
    echo "scripts/build-static: $stage/bin/sqiff is not static" >&2
    exit 1
fi

# opt-env-conf writes the absolute path it is given into each script, for the
# script to run. The tarball can be unpacked anywhere, so the scripts run sqiff
# from PATH instead.
completion() {
    local binary="$PWD/$stage/bin/sqiff"
    "$binary" "--$1-completion-script" "$binary" | sed "s|$binary|sqiff|g" > "$stage/share/$2"
}
completion bash bash-completion/completions/sqiff
completion zsh zsh/site-functions/_sqiff
completion fish fish/vendor_completions.d/sqiff.fish

tarball="$out/sqiff-$(uname -m)-linux.tar.xz"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime=@1 \
    -cJf "$tarball" -C "$stage" bin share

echo "$tarball"
