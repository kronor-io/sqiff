cabal-version:      3.0
name:               sqiff
version:            0.1.0.0
synopsis:           Describe and diff PostgreSQL schemas from their catalogs
build-type:         Simple
extra-source-files:
  sql/depend.sql
  sql/depend_from.sql
  sql/depend_on.sql
  sql/describe/*.sql
  sql/plpgsql/*.sql

common shared
  default-language:   GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    LambdaCase

  ghc-options:        -Wall

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Sqiff.Baseline
    Sqiff.Body
    Sqiff.Catalog
    Sqiff.Config
    Sqiff.Diff
    Sqiff.Folder
    Sqiff.Git
    Sqiff.Identifier
    Sqiff.Model
    Sqiff.Plan
    Sqiff.Recipe
    Sqiff.Rewrite
    Sqiff.Script
    Sqiff.Sqitch
    Sqiff.TableEdit
    Sqiff.Timing

  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , crypton
    , file-embed
    , filepath
    , hasql
    , hasql-th
    , pqi-ffi
    , rio
    , string-interpolate
    , text
    , time
    , typed-process
    , vector
    , yaml

executable sqiff
  import:         shared
  hs-source-dirs: app
  main-is:        Sqiff.hs
  ghc-options:
    -main-is Sqiff.main -threaded -rtsopts -with-rtsopts=-N4

  build-depends:
    , base
    , containers
    , Diff
    , filepath
    , hasql
    , sqiff
    , optparse-applicative
    , rio
    , string-interpolate
    , text
    , time

test-suite sqiff-test
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  other-modules:
    Integration
    Postgres
    Unit

  ghc-options:        -threaded -rtsopts -with-rtsopts=-N4
  build-tool-depends: sqiff:sqiff
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , hasql
    , hedgehog
    , rio
    , sqiff
    , string-interpolate
    , tasty
    , tasty-expected-failure
    , tasty-golden
    , tasty-hedgehog
    , tasty-hunit
    , temporary
    , text
    , typed-process
